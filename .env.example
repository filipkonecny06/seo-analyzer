# HTTP server
HOST=0.0.0.0
PORT=3000
REQUEST_TIMEOUT_MS=15000
TRUST_PROXY=false

# Outbound page fetch
OUTBOUND_USER_AGENT=OnPageSEOAnalyzer/2.0.0
ALLOWED_TARGET_PORTS=80,443
DNS_TIMEOUT_MS=3000
FETCH_TIMEOUT_MS=10000
MAX_RESPONSE_BYTES=2000000
MAX_REDIRECTS=4
MAX_URL_LENGTH=2048

# Single-process abuse controls
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000
MAX_CONCURRENT_ANALYSES=4

# Isolated HTML analysis
ANALYSIS_TIMEOUT_MS=5000
ANALYSIS_MAX_OLD_SPACE_MB=128
ANALYSIS_MAX_YOUNG_SPACE_MB=16
ANALYSIS_STACK_SIZE_MB=4
