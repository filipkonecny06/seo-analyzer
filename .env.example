# HTTP server
HOST=0.0.0.0
PORT=3000
REQUEST_TIMEOUT_MS=15000
TRUST_PROXY=false

# Outbound page fetch
OUTBOUND_USER_AGENT=PortfolioSEOAnalyzer/2.0
ALLOWED_TARGET_PORTS=80,443
DNS_TIMEOUT_MS=3000
FETCH_TIMEOUT_MS=10000
MAX_RESPONSE_BYTES=2000000
MAX_REDIRECTS=4
MAX_URL_LENGTH=2048

# Single-process abuse controls
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000
MAX_CONCURRENT_ANALYSES=4
